# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codesentinel:codesentinel@localhost:5432/codesentinel

# ── GitHub App ───────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=

# ── LLM Provider ─────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=

# ── Reasoning Model Config (GPT-5.6 family) ──────────────
# Supported: none, minimal, low, medium, high, xhigh, max
REASONING_EFFORT=low

# ── Cross-model Verifier ─────────────────────────────────
VERIFIER_PROVIDER=openai
VERIFIER_MODEL=gpt-4o
VERIFIER_REASONING_EFFORT=medium

# ── Server ───────────────────────────────────────────────
PORT=8000
DASHBOARD_BASE_URL=http://localhost:3000

# ── Review Worker ────────────────────────────────────────
REVIEW_CONCURRENCY=3
REVIEW_POLL_INTERVAL_SECONDS=2
REVIEW_LOCK_SECONDS=900
REVIEW_MAX_ATTEMPTS=5
REVIEW_BACKOFF_BASE_SECONDS=60

# ── Agent Configuration ──────────────────────────────────
AGENT_CONCURRENCY=3
MAX_FILES=500
MAX_CONTEXT_KB=256
MAX_FILE_REQUEST_ROUNDS=3
MAX_TOKENS_PER_AGENT=4096
CONFIDENCE_FLOOR=75
MAX_FINDINGS=25

# ── RAG / Vector Search (OpenAI Embeddings) ──────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Analytics ────────────────────────────────────────────
INSIGHTS_ROLLUP_INTERVAL_MINUTES=60
